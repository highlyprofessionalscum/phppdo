{
    "name": "phppdo/phppdo",
    "description": "Userland PDO for PHP 7.4: ODBC through ext-odbc, MySQL and PostgreSQL through FFI.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-odbc": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11"
    },
    "scripts": {
        "ffi-preload": "php ffi/generate-preload.php",
        "test": "php tests/run.php",
        "test-phpunit": "phpunit",
        "test-docker": [
            "docker build -t phppdo .",
            "docker run --rm phppdo"
        ],
        "analyse": "phpstan analyse -c phpstan.neon.dist",
        "check": [
            "@test",
            "@analyse"
        ],
        "ci-local": [
            "@test",
            "@ffi-preload",
            "@test-docker"
        ]
    },
    "autoload": {
        "psr-4": {
            "PhpPdo\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    }
}
